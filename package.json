{
  "name": "playwright-quality-engineering",
  "version": "2.0.0",
  "private": true,
  "description": "Risk-based Playwright quality suite for UI, accessibility, API contracts, compatibility, and performance",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:a11y": "playwright test tests/accessibility",
    "test:contract": "playwright test tests/contracts --project=chromium",
    "test:extended": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "quality-engineering",
    "e2e-testing",
    "accessibility",
    "api-testing",
    "ci-cd"
  ],
  "author": "Santiago Madriz",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
